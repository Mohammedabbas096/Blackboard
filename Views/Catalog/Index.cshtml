@model CatalogViewModel
@{
    ViewData["Title"] = "Course Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Course Catalog</h1>
        <p class="text-muted mb-0">Browse university courses, filter by academic discipline, and add courses to your plan.</p>
    </div>
    <div>
        <a asp-controller="Plan" asp-action="Index" class="btn btn-outline-primary">
            View My Plan
        </a>
    </div>
</div>

<!-- Major Filter Pills -->
<div class="card mb-4 shadow-sm border-0 bg-light">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold text-secondary me-2">Major:</span>
            <a asp-action="Index" asp-route-majorId="0"
               class="btn btn-sm @(Model.SelectedMajorId == 0 ? "btn-primary" : "btn-outline-secondary")">
                All Majors
            </a>
            @foreach (var major in Model.Majors)
            {
                <a asp-action="Index" asp-route-majorId="@major.MajorId"
                   class="btn btn-sm @(Model.SelectedMajorId == major.MajorId ? "btn-primary" : "btn-outline-secondary")">
                    @major.Name
                </a>
            }
        </div>
    </div>
</div>

<!-- Courses Grid -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @if (Model.Courses.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                No courses found for the selected major filter.
            </div>
        </div>
    }
    else
    {
        @foreach (var course in Model.Courses)
        {
            bool isPlanned = Model.PlannedCourseIds.Contains(course.CourseId);
            bool isReserved = Model.ReservedCourseIds.Contains(course.CourseId);

            <div class="col">
                <div class="card h-100 shadow-sm border">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom">
                        <span class="badge bg-primary fs-6">@course.CourseNumber</span>
                        <span class="badge bg-secondary">@course.Units Units</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-dark">@course.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">@course.Description</p>
                        <div class="mt-3 pt-2 border-top small text-secondary">
                            <div><strong>Major:</strong> @course.Major.Name</div>
                            <div><strong>Instructor:</strong> @course.Instructor.FullName</div>
                            <div><strong>Schedule:</strong> @course.Schedule (@course.Time)</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            @if (isReserved)
                            {
                                <span class="badge bg-success py-2 px-3">
                                    <i class="bi bi-check-circle"></i> Reserved
                                </span>
                            }
                            else if (isPlanned)
                            {
                                <span class="badge bg-warning text-dark py-2 px-3">
                                    In Your Plan
                                </span>
                            }
                            else
                            {
                                <form asp-controller="Plan" asp-action="Add" method="post" class="w-100">
                                    <input type="hidden" name="courseId" value="@course.CourseId" />
                                    <input type="hidden" name="returnMajorId" value="@Model.SelectedMajorId" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                        + Add to Plan
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
