@{
    Layout = "_RootLayout";
    var session = new BlackboardSession(Context.Session);
    int? planCount = session.GetPlanCount();
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
    <div class="container-fluid">
        <a class="navbar-brand"
           asp-area="" asp-controller="Home" asp-action="Index">Group1Blackboard</a>
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#studentNav"
                aria-controls="studentNav" aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="studentNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")"
                       asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Catalog" ? "active" : "")"
                       asp-area="" asp-controller="Catalog" asp-action="Index">Catalog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Plan" && currentAction == "Index" ? "active" : "")"
                       asp-area="" asp-controller="Plan" asp-action="Index">
                        My Plan
                        @if (planCount.HasValue && planCount.Value > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@planCount.Value</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Plan" && currentAction == "Reservations" ? "active" : "")"
                       asp-area="" asp-controller="Plan" asp-action="Reservations">Reservations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Calendar" ? "active" : "")"
                       asp-area="" asp-controller="Calendar" asp-action="Index">Calendar</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container">
    @* Single-point TempData message rendering across all student views *@
    @if (TempData["message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-4">
    <div class="container py-2">
        &copy; 2026 - Group1Blackboard
    </div>
</footer>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
