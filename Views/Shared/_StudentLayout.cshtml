@{
    Layout = "_RootLayout";
}

<nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
    <div class="container-fluid">
        <a class="navbar-brand"
           asp-area="Student" asp-controller="Home" asp-action="Index">Group1Blackboard</a>
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#studentNav"
                aria-controls="studentNav" aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="studentNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-area="Student" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")"
                       asp-area="Student" asp-controller="Catalog" asp-action="Index">Catalog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calendar" ? "active" : "")"
                       asp-area="Student" asp-controller="Calendar" asp-action="Index">Calendar</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Admin" asp-controller="Major" asp-action="Index">Admin</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-4">
    <div class="container py-2">
        &copy; 2026 - Group1Blackboard
    </div>
</footer>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
