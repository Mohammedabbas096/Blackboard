@model ReservationsViewModel
@{
    ViewData["Title"] = "Confirmed Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Confirmed Reservations</h1>
        <p class="text-muted mb-0">Official course reservations permanently saved in the university database.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">
            Browse Catalog
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            View Current Plan
        </a>
    </div>
</div>

<!-- Student Header -->
<div class="card mb-4 bg-light border-0 shadow-sm">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="text-secondary small d-block">Student Record</span>
            <span class="fw-bold fs-5 text-dark">@Model.DemonstrationStudentName</span>
            <span class="badge bg-secondary ms-2">ID: @Model.DemonstrationStudentId</span>
        </div>
        <div class="d-flex gap-4">
            <div class="text-center">
                <span class="text-secondary small d-block">Total Reservations</span>
                <span class="fw-bold fs-4 text-success">@Model.Reservations.Count</span>
            </div>
            <div class="text-center">
                <span class="text-secondary small d-block">Enrolled Units</span>
                <span class="fw-bold fs-4 text-success">@Model.TotalReservedUnits</span>
            </div>
        </div>
    </div>
</div>

@if (Model.Reservations.Count == 0)
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <h4 class="text-muted mb-3">No confirmed reservations found</h4>
            <p class="text-secondary mb-4">You have not reserved any courses yet. Add courses to your plan and confirm your reservation.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4">
                Explore Course Catalog
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border mb-4">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ref #</th>
                        <th>Course</th>
                        <th>Title</th>
                        <th>Major</th>
                        <th>Instructor</th>
                        <th>Schedule</th>
                        <th class="text-center">Units</th>
                        <th>Reservation Date</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model.Reservations)
                    {
                        <tr>
                            <td class="text-muted small">#@reservation.ReservationId</td>
                            <td>
                                <span class="badge bg-primary">@reservation.Course.CourseNumber</span>
                            </td>
                            <td class="fw-semibold">@reservation.Course.Title</td>
                            <td>@reservation.Course.Major.Name</td>
                            <td>@reservation.Course.Instructor.FullName</td>
                            <td>@reservation.Course.Schedule <span class="text-muted small">(@reservation.Course.Time)</span></td>
                            <td class="text-center fw-bold">@reservation.Course.Units</td>
                            <td class="small text-secondary">
                                @reservation.ReservationDate.ToString("MMM dd, yyyy h:mm tt")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">@reservation.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-bold">Total Confirmed Units:</td>
                        <td class="text-center fw-bold text-success fs-5">@Model.TotalReservedUnits</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
