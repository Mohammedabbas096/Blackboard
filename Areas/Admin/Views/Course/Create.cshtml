@model Group1Blackboard.Models.Course
@{
    ViewData["Title"] = "Add Course";
}

<h1>Add Course</h1>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="CourseNumber" class="form-label"></label>
                <input asp-for="CourseNumber" class="form-control" placeholder="e.g. CS 101" />
                <span asp-validation-for="CourseNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Units" class="form-label"></label>
                    <input asp-for="Units" class="form-control" type="number" min="1" max="6" />
                    <span asp-validation-for="Units" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Schedule" class="form-label"></label>
                    <select asp-for="Schedule" asp-items="ViewBag.Schedules" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Schedule" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Time" class="form-label"></label>
                    <input asp-for="Time" class="form-control" placeholder="e.g. 09:00 AM - 09:50 AM" />
                    <span asp-validation-for="Time" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MajorId" class="form-label">Major</label>
                <select asp-for="MajorId" asp-items="ViewBag.Majors" class="form-select">
                    <option value="">-- Select Major --</option>
                </select>
                <span asp-validation-for="MajorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InstructorId" class="form-label">Instructor</label>
                <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select">
                    <option value="">-- Select Instructor --</option>
                </select>
                <span asp-validation-for="InstructorId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary ms-1">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
