@model IEnumerable<Group1Blackboard.Models.Major>
@{
    ViewData["Title"] = "Majors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Majors</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Major</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No majors found. Add one to get started.</p>
}
else
{
    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Courses</th>
                <th style="width:160px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var major in Model)
            {
                <tr>
                    <td>@major.Name</td>
                    <td>@major.Courses.Count</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@major.MajorId"
                           class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@major.MajorId"
                           class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
