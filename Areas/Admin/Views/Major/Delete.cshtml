@model Group1Blackboard.Models.Major
@{
    ViewData["Title"] = "Delete Major";
}

<h1>Delete Major</h1>
<hr />

@if (Model.Courses.Any())
{
    <div class="alert alert-warning">
        <strong>Cannot delete this major.</strong>
        It has <strong>@Model.Courses.Count</strong> course(s) assigned to it.
        Remove or reassign those courses first.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete the major <strong>@Model.Name</strong>?
        This action cannot be undone.
    </div>

    <dl class="row mb-3">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MajorId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-1">Cancel</a>
    </form>
}
